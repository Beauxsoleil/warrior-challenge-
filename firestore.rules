rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(c) { return get(/databases/$(database)/documents/competitions/$(c)/members/$(request.auth.uid)).data; }
    function active(c) { return request.auth != null && member(c).active == true; }
    function admin(c) { return active(c) && member(c).role == 'admin'; }
    function station(c, e) { return active(c) && (admin(c) || e in member(c).eventIds); }
    function safeId(s) { return s is string && s.matches('^[A-Za-z0-9_-]{1,80}$'); }
    function parent(c, p) { return get(/databases/$(database)/documents/competitions/$(c)/journal/$(p)).data; }
    function sameParent(c, d, p) {
      let prior = parent(c,p);
      return safeId(p) && p != d.opId && prior.competitionId == c
        && prior.eventId == d.eventId && prior.teamId == d.teamId
        && prior.schemaVersion == 1 && prior.rulesVersion == d.rulesVersion
        && prior.kind in ['result.submit','result.correct','result.void','result.resolve'];
    }
    function parents(c,d) {
      return d.parentIds is list && d.parentIds.size() <= 4
        && d.parentIds.toSet().size() == d.parentIds.size()
        && (d.parentIds.size() < 1 || sameParent(c,d,d.parentIds[0]))
        && (d.parentIds.size() < 2 || sameParent(c,d,d.parentIds[1]))
        && (d.parentIds.size() < 3 || sameParent(c,d,d.parentIds[2]))
        && (d.parentIds.size() < 4 || sameParent(c,d,d.parentIds[3]));
    }
    function validKind(c,d) {
      return (d.kind == 'result.submit' && d.parentIds.size() == 0)
        || (d.kind == 'result.void' && d.parentIds.size() == 1
            && (admin(c) || (parent(c,d.parentIds[0]).actorUid == request.auth.uid && parent(c,d.parentIds[0]).kind != 'result.void')))
        || (d.kind == 'result.correct' && d.parentIds.size() == 1
            && (admin(c) || (parent(c,d.parentIds[0]).kind == 'result.void' && parent(c,d.parentIds[0]).actorUid == request.auth.uid)))
        || (d.kind == 'result.resolve' && d.parentIds.size() >= 2 && admin(c));
    }
    function payload(d,e) {
      return d.payload is map && d.payload.reason is string && d.payload.reason.size() <= 500
        && (d.kind == 'result.submit' || d.payload.reason.size() >= 1)
        && ((d.kind == 'result.void' && d.payload.keys().hasOnly(['reason']) && d.payload.keys().hasAll(['reason']))
          || (d.kind != 'result.void' && d.payload.keys().hasOnly(['value','reason']) && d.payload.keys().hasAll(['value','reason'])
            && d.payload.value is int && d.payload.value >= e.minimum && d.payload.value <= e.maximum));
    }
    function valid(c,op,d) {
      let config = get(/databases/$(database)/documents/competitions/$(c)).data;
      let event = get(/databases/$(database)/documents/competitions/$(c)/events/$(d.eventId)).data;
      let team = get(/databases/$(database)/documents/competitions/$(c)/teams/$(d.teamId)).data;
      return d.keys().hasOnly(['opId','competitionId','eventId','teamId','schemaVersion','rulesVersion','actorUid','deviceId','sessionId','capturedAtClientMs','kind','parentIds','payload','receivedAt'])
        && d.keys().hasAll(['opId','competitionId','eventId','teamId','schemaVersion','rulesVersion','actorUid','deviceId','sessionId','capturedAtClientMs','kind','parentIds','payload','receivedAt'])
        && safeId(op) && d.opId == op && d.competitionId == c
        && safeId(d.eventId) && safeId(d.teamId) && safeId(d.deviceId) && safeId(d.sessionId)
        && d.actorUid == request.auth.uid && d.schemaVersion == 1 && d.rulesVersion == 'practice-v1'
        && config.mode == 'practice' && config.rulesVersion == d.rulesVersion
        && team.eligible == true && team.rosterVersion == config.rosterVersion
        && event.kind == 'numeric' && event.minimum == 0 && event.maximum == 100
        && event.state in ['open','closing'] && station(c,d.eventId)
        && d.capturedAtClientMs is int && d.capturedAtClientMs >= 0 && d.capturedAtClientMs <= 9007199254740991
        && d.receivedAt == request.time && parents(c,d) && validKind(c,d) && payload(d,event);
    }
    match /competitions/{c} {
      allow read: if active(c);
      match /members/{uid} { allow read: if active(c) && (uid == request.auth.uid || admin(c)); }
      match /teams/{id} { allow read: if active(c); }
      match /events/{id} { allow read: if station(c,id); }
      match /journal/{op} {
        // Missing-ID reads permit idempotency checks, not enumeration of private data.
        allow get: if active(c) && (!exists(/databases/$(database)/documents/competitions/$(c)/journal/$(op)) || station(c,resource.data.eventId));
        allow list: if station(c,resource.data.eventId);
        allow create: if active(c) && valid(c,op,request.resource.data);
        allow update, delete: if false;
      }
      // Publication is deliberately closed until M4's atomic protocol is implemented.
    }
    match /{path=**} { allow read, write: if false; }
  }
}
