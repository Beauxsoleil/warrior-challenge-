{
  "name": "warrior-challenge",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:rules": "firebase emulators:exec --only firestore --project demo-warrior-challenge \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-warrior-challenge \"npm run seed:emulator && playwright test\"",
    "build": "tsc --noEmit && vite build",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-warrior-challenge",
    "seed:emulator": "node --experimental-strip-types scripts/seed.ts",
    "build:pages": "tsc --noEmit && node --experimental-strip-types scripts/build-pages.ts",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beauxsoleil/warrior-challenge-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Beauxsoleil/warrior-challenge-/issues"
  },
  "homepage": "https://github.com/Beauxsoleil/warrior-challenge-#readme",
  "dependencies": {
    "firebase": "13.1.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "firebase-tools": "15.34.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
